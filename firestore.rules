rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 0. SEGURIDAD POR DEFECTO: DENEGAR TODO ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- FUNCIONES GLOBALES DE AYUDA ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getEmail() {
      return isSignedIn() ? request.auth.token.get('email', '').lower() : "";
    }

    function isSuperAdmin() {
      let email = getEmail();
      return email == "taliana.moreno@segurosbolivar.com" || 
             email == "helen.pantoja@segurosbolivar.com" ||
             request.auth.uid == "tdev4fgZqwRxFNb9ujNsZHld5ZB3";
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'asesor') == "admin")
      );
    }

    function isSupervisor() {
      let email = getEmail();
      return isSignedIn() && (
        email == "sergio.llanos@segurosbolivar.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'asesor') == "supervisor")
      );
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. Usuarios (Directorio y Perfiles)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupervisor());
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email'])) ||
        isAdmin() ||
        isSuperAdmin()
      );
    }

    // 2. Logs de Acceso
    match /login_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || isSuperAdmin() || isSupervisor();
    }

    // 3. Asesores (Directorio de Receptores)
    match /asesores/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    match /advisors/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // 4. Gestiones (Registros de transferencias)
    function isOwner(data) {
      // Importante: No usar .lower() sobre data.field para permitir queries de listado
      return isSignedIn() && getEmail() != "" && (
        (data.get('fromAdvisorEmail', '') == getEmail()) || 
        (data.get('toAdvisorEmail', '') == getEmail()) ||
        (data.get('createdBy', '') == getEmail())
      );
    }

    match /registros/{registroId} {
      allow read: if isSignedIn() && (isAdmin() || isSupervisor() || isOwner(resource.data));
      
      allow create: if isSignedIn() && (
        request.resource.data.get('fromAdvisorEmail', '') == getEmail() || 
        isAdmin() || 
        isSupervisor()
      );
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        isSupervisor() ||
        (isOwner(resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fromAdvisorEmail', 'createdAt']))
      );
      
      allow delete: if isAdmin() || isSuperAdmin();
    }
  }
}
