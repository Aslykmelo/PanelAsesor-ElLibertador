rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 0. SEGURIDAD POR DEFECTO: DENEGAR TODO ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- FUNCIONES GLOBALES DE AYUDA ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getEmail() {
      // Uso directo de request.auth.token.email si está disponible
      return isSignedIn() ? request.auth.token.get('email', '').lower() : "";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return getEmail() == "taliana.moreno@segurosbolivar.com" || 
             getEmail() == "helen.pantoja@segurosbolivar.com" ||
             request.auth.uid == "tdev4fgZqwRxFNb9ujNsZHld5ZB3";
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'asesor') == "admin")
      );
    }

    function isSupervisor() {
      return isSignedIn() && (
        getEmail() == "sergio.llanos@segurosbolivar.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'asesor') == "supervisor")
      );
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. Usuarios (Directorio y Perfiles)
    match /users/{userId} {
      // Permitir leer perfil propio o si es admin/super/supervisor
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupervisor());
      // Permitir listar (directorio) a cualquier usuario autenticado del dominio
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email'])) ||
        isAdmin() ||
        isSuperAdmin()
      );
    }

    // 2. Logs de Acceso
    match /login_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || isSuperAdmin();
    }

    // 3. Asesores (Directorio de Receptores)
    // Cobertura total para queries de colección y lectura individual
    match /asesores/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    // Alias por si acaso se usa advisors en el backend/blueprint
    match /advisors/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // 4. Gestiones (Registros de transferencias)
    function isOwner(data) {
      return isSignedIn() && getEmail() != "" && (
        (data.get('fromAdvisorEmail', '').lower() == getEmail()) || 
        (data.get('toAdvisorEmail', '').lower() == getEmail())
      );
    }

    match /registros/{registroId} {
      // Lectura individual (get) y listado (list)
      // Para list, Firestore verificará que la query solo pida lo que el usuario puede ver
      allow get: if isSignedIn() && (isAdmin() || isSupervisor() || isOwner(resource.data));
      allow list: if isSignedIn() && (isAdmin() || isSupervisor() || isOwner(resource.data));
      
      allow create: if isSignedIn() && (
        request.resource.data.get('fromAdvisorEmail', '').lower() == getEmail() || 
        isAdmin() || 
        isSupervisor()
      );
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        isSupervisor() ||
        (isOwner(resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fromAdvisorEmail', 'createdAt']))
      );
      
      allow delete: if isAdmin() || isSuperAdmin();
    }
  }
}
