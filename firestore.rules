rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Bloqueo total por defecto
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Ayudantes (Sintaxis CEL pura) ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getEmail() {
      return isSignedIn() && "email" in request.auth.token ? request.auth.token.email.lower() : "";
    }

    function isAdmin() {
      return isSignedIn() && (
        getEmail() == "taliana.moreno@segurosbolivar.com" || 
        getEmail() == "helen.pantoja@segurosbolivar.com" || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'asesor') == "admin")
      );
    }

    function isSupervisor() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'asesor') == "supervisor";
    }

    function isOwner(data) {
      return isSignedIn() && getEmail() != "" && (
        (data.get('fromAdvisorEmail', '') is string && data.get('fromAdvisorEmail', '').lower() == getEmail()) || 
        (data.get('toAdvisorEmail', '') is string && data.get('toAdvisorEmail', '').lower() == getEmail())
      );
    }

    // --- Colecciones ---

    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /login_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /registros/{registroId} {
      // Reglas de lectura: Los admins y supervisores ven todo. Los asesores solo lo suyo.
      allow list, get: if isSignedIn() && (isAdmin() || isSupervisor() || isOwner(resource.data));
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        isSupervisor() ||
        isOwner(resource.data)
      );
      
      allow delete: if isAdmin();
    }

    match /advisors/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
