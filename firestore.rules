rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 0. SEGURIDAD POR DEFECTO: DENEGAR TODO ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- FUNCIONES GLOBALES DE AYUDA ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getEmail() {
      return (isSignedIn() && request.auth.token.email != null) ? request.auth.token.email.lower() : "";
    }

    function isKnownAdminEmail(email) {
      return email == "taliana.moreno@segurosbolivar.com" || 
             email == "helen.pantoja@segurosbolivar.com";
    }

    function isKnownSupervisorEmail(email) {
      return email == "sergio.llanos@segurosbolivar.com" ||
             email == "luis.mondragon@segurosbolivar.com" ||
             email == "yulieth.moreno@segurosbolivar.com" ||
             email == "ana.gutierrez@segurosbolivar.com" ||
             email == "mabel.elizabeth.andrade@segurosbolivar.com" ||
             email == "lizeth.osma@segurosbolivar.com" ||
             email == "juliana.garcia@segurosbolivar.com";
    }

    function isAllowedRole(newRole, email) {
      return newRole == 'asesor' ||
             (newRole == 'supervisor' && (isKnownSupervisorEmail(email) || isKnownAdminEmail(email))) ||
             (newRole == 'admin' && isKnownAdminEmail(email));
    }

    function isSuperAdmin() {
      let email = getEmail();
      return isKnownAdminEmail(email) || 
             request.auth.uid == "tdev4fgZqwRxFNb9ujNsZHld5ZB3";
    }

    function isAdmin() {
      let email = getEmail();
      return isSignedIn() && (
        isKnownAdminEmail(email) || 
        request.auth.uid == "tdev4fgZqwRxFNb9ujNsZHld5ZB3"
      );
    }

    function isSupervisor() {
      let email = getEmail();
      return isSignedIn() && (
        isKnownSupervisorEmail(email) ||
        isKnownAdminEmail(email)
      );
    }

    // Únicos que pueden ver y validar (aprobar/rechazar) el módulo de
    // solicitudes redirigidas a NGSO — independiente del rol/cartera.
    function isKnownNgsoValidatorEmail(email) {
      return email == "aldair.avila@segurosbolivar.com" ||
             email == "helen.pantoja@segurosbolivar.com" ||
             email == "asly.camelo@segurosbolivar.com";
    }

    function isNgsoValidator() {
      let email = getEmail();
      return isSignedIn() && (isKnownNgsoValidatorEmail(email) || isAdmin());
    }

    // Únicos que pueden subir el CSV de totales de llamadas por asesor —
    // independiente del rol/cartera.
    function isKnownControllerEmail(email) {
      return email == "helen.pantoja@segurosbolivar.com" ||
             email == "sergio.llanos@segurosbolivar.com" ||
             email == "luis.padilla@segurosbolivar.com" ||
             email == "doris.benavides@segurosbolivar.com" ||
             email == "asly.camelo@segurosbolivar.com";
    }

    function isController() {
      let email = getEmail();
      return isSignedIn() && (isKnownControllerEmail(email) || isAdmin());
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. Usuarios (Directorio y Perfiles)
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // 2. Logs de Acceso
    match /login_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isAdmin() || isSupervisor());
    }

    // 3. Asesores (Directorio de Receptores)
    match /asesores/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /advisors/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 4. Gestiones (Registros de transferencias)
    function isOwner(data) {
      return isSignedIn() && getEmail() != "" && (
        (data.get('fromAdvisorEmail', '') == getEmail()) || 
        (data.get('toAdvisorEmail', '') == getEmail()) ||
        (data.get('createdBy', '') == getEmail())
      );
    }

    match /registros/{registroId} {
      allow read: if isSignedIn() && (isAdmin() || isSupervisor() || isOwner(resource.data));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || isSupervisor() || isOwner(resource.data));
      allow delete: if isSignedIn() && (isAdmin() || isSupervisor());
    }

    // 5. Recaudo Histórico (Conciliaciones)
    match /recaudo_historico/{recordId} {
      allow read, write: if isSignedIn();
    }

    // 6. Solicitudes redirigidas a NGSO (cola de validación de supervisor)
    function isNgsoRedirectOwner(data) {
      return isSignedIn() && getEmail() != "" && data.get('redirectedByEmail', '') == getEmail();
    }

    match /ngso_redirects/{recordId} {
      allow read: if isSignedIn() && (isNgsoValidator() || isNgsoRedirectOwner(resource.data));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isNgsoValidator();
      allow delete: if isSignedIn() && isAdmin();
    }

    // 7. Totales de llamadas por asesor (subidos por Controller). El asesor
    // solo ve su propio total — el id del documento es su correo.
    match /call_totals/{advisorEmail} {
      allow read: if isSignedIn() && (getEmail() == advisorEmail || isController());
      allow write: if isController();
    }

  }
}
