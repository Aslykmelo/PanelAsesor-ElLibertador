rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 0. SEGURIDAD POR DEFECTO: DENEGAR TODO ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- FUNCIONES GLOBALES DE AYUDA ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getEmail() {
      return (isSignedIn() && request.auth.token.email != null) ? request.auth.token.email.lower() : "";
    }

    function isKnownAdminEmail(email) {
      return email == "taliana.moreno@segurosbolivar.com" || 
             email == "helen.pantoja@segurosbolivar.com" ||
             email == "asly.camelo@segurosbolivar.com";
    }

    function isKnownSupervisorEmail(email) {
      return email == "sergio.llanos@segurosbolivar.com" ||
             email == "luis.mondragon@segurosbolivar.com" ||
             email == "yulieth.moreno@segurosbolivar.com" ||
             email == "ana.gutierrez@segurosbolivar.com" ||
             email == "mabel.elizabeth.andrade@segurosbolivar.com" ||
             email == "lizeth.osma@segurosbolivar.com" ||
             email == "juliana.garcia@segurosbolivar.com";
    }

    function isAllowedRole(newRole, email) {
      return newRole == 'asesor' ||
             (newRole == 'supervisor' && (isKnownSupervisorEmail(email) || isKnownAdminEmail(email))) ||
             (newRole == 'admin' && isKnownAdminEmail(email));
    }

    function isSuperAdmin() {
      let email = getEmail();
      return isKnownAdminEmail(email) || 
             request.auth.uid == "tdev4fgZqwRxFNb9ujNsZHld5ZB3";
    }

    // Rol asignado a mano desde "Gestión de Usuarios" (colección
    // role_overrides, un documento por correo; solo lo escriben los
    // administradores fijos del sistema). Vacío si no hay ninguno. Los
    // administradores fijos (isKnownAdminEmail) nunca se degradan por esto.
    function overrideRole() {
      let path = /databases/$(database)/documents/role_overrides/$(getEmail());
      return (isSignedIn() && getEmail() != "" && exists(path)) ? get(path).data.get('role', '') : '';
    }

    function isAdmin() {
      let email = getEmail();
      return isSignedIn() && (
        isKnownAdminEmail(email) ||
        request.auth.uid == "tdev4fgZqwRxFNb9ujNsZHld5ZB3" ||
        overrideRole() == 'admin'
      );
    }

    function isSupervisor() {
      let email = getEmail();
      let override = overrideRole();
      return isSignedIn() && (
        isKnownAdminEmail(email) ||
        (isKnownSupervisorEmail(email) && override != 'asesor') ||
        override == 'supervisor' ||
        override == 'admin'
      );
    }

    // Únicos que pueden ver y validar (aprobar/rechazar) el módulo de
    // solicitudes redirigidas a NGSO — independiente del rol/cartera.
    function isKnownNgsoValidatorEmail(email) {
      return email == "aldair.avila@segurosbolivar.com" ||
             email == "helen.pantoja@segurosbolivar.com" ||
             email == "asly.camelo@segurosbolivar.com";
    }

    function isNgsoValidator() {
      let email = getEmail();
      return isSignedIn() && (isKnownNgsoValidatorEmail(email) || isAdmin());
    }

    // Equipo Controller: puede buscar cualquier asesor y ver sus conversaciones
    // (conversation_stats) — independiente del rol/cartera.
    function isKnownControllerEmail(email) {
      return email == "helen.pantoja@segurosbolivar.com" ||
             email == "sergio.llanos@segurosbolivar.com" ||
             email == "luis.padilla@segurosbolivar.com" ||
             email == "doris.benavides@segurosbolivar.com" ||
             email == "asly.camelo@segurosbolivar.com";
    }

    function isController() {
      let email = getEmail();
      return isSignedIn() && (isKnownControllerEmail(email) || isAdmin());
    }

    // Correo del supervisor asignado al usuario autenticado, según su propio
    // documento en /users — usado para que un asesor solo pueda leer las
    // conversaciones de sus propios compañeros de equipo.
    function myOwnSupervisorEmail() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('supervisorEmail' in profile) ? profile.supervisorEmail.lower() : '';
    }

    // Único que carga el reporte de bitácoras por asesor (desde su perfil).
    function isBitacoraUploader() {
      let email = getEmail();
      return isSignedIn() && (email == "asly.camelo@segurosbolivar.com" || isAdmin());
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. Usuarios (Directorio y Perfiles)
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // 1b. Roles asignados a mano. Cada quien puede leer el suyo (para el login);
    // los administradores leen todos; solo los administradores fijos del
    // sistema pueden asignarlos o quitarlos.
    match /role_overrides/{emailId} {
      allow read: if isSignedIn() && (getEmail() == emailId || isAdmin());
      allow write: if isSuperAdmin();
    }

    // 2. Logs de Acceso
    match /login_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isAdmin() || isSupervisor());
    }

    // 3. Asesores (Directorio de Receptores)
    match /asesores/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /advisors/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 4. Gestiones (Registros de transferencias)
    function isOwner(data) {
      return isSignedIn() && getEmail() != "" && (
        (data.get('fromAdvisorEmail', '') == getEmail()) || 
        (data.get('toAdvisorEmail', '') == getEmail()) ||
        (data.get('createdBy', '') == getEmail())
      );
    }

    match /registros/{registroId} {
      allow read: if isSignedIn() && (isAdmin() || isSupervisor() || isOwner(resource.data));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || isSupervisor() || isOwner(resource.data));
      allow delete: if isSignedIn() && (isAdmin() || isSupervisor());
    }

    // 5. Recaudo Histórico (Conciliaciones)
    match /recaudo_historico/{recordId} {
      allow read, write: if isSignedIn();
    }

    // 6. Solicitudes redirigidas a NGSO (cola de validación de supervisor)
    function isNgsoRedirectOwner(data) {
      return isSignedIn() && getEmail() != "" && data.get('redirectedByEmail', '') == getEmail();
    }

    match /ngso_redirects/{recordId} {
      allow read: if isSignedIn() && (isNgsoValidator() || isNgsoRedirectOwner(resource.data));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isNgsoValidator();
      allow delete: if isSignedIn() && isAdmin();
    }

    // 9. Caché compartida del tráfico de llamadas de ITBX (por día) — no es
    // información sensible por persona, cualquier asesor autenticado puede
    // leerla y refrescarla; así se evita que cada uno dispare su propia
    // consulta contra ITBX.
    match /itbx_cache/{dayKey} {
      allow read, write: if isSignedIn();
    }

    // Recaudo bancario compartido (Seguimiento Recaudo / Premiación Recaudo).
    // Trae nombres de clientes y valores: solo supervisores, administradores y
    // Controller pueden leerlo o cargarlo — nunca los asesores.
    match /recaudo_shared/{docId} {
      allow read, write: if isSupervisor() || isController();
    }

    // 11. Conversaciones de hoy por asesor (Infobip) — cada quien publica la
    // suya al refrescarla en su perfil. Solo puede leerse la propia, la de
    // un compañero con el mismo supervisor (para "Mi Equipo"), o si quien
    // consulta es supervisor/admin/Controller (para "Buscar Asesor").
    match /conversation_stats/{advisorEmail} {
      allow read: if isSignedIn() && (
        getEmail() == advisorEmail ||
        isSupervisor() ||
        isController() ||
        myOwnSupervisorEmail() == resource.data.supervisorEmail
      );
      allow write: if isSignedIn() && getEmail() == advisorEmail;
    }

    // 10. Bitácoras por asesor (las sube quien administra el reporte). El id
    // del documento es el correo del asesor: cada uno lee solo la suya.
    match /bitacoras/{advisorEmail} {
      allow read: if isSignedIn() && (getEmail() == advisorEmail || isBitacoraUploader());
      allow write: if isBitacoraUploader();
    }

  }
}
