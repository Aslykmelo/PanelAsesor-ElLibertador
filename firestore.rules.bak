rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- SEGURIDAD POR DEFECTO: DENEGAR TODO ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- FUNCIONES GLOBALES DE AYUDA ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getEmail() {
      return isSignedIn() && "email" in request.auth.token ? request.auth.token.email.lower() : "";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Identidades fijas por seguridad máxima
    function isSuperAdmin() {
      return getEmail() == "taliana.moreno@segurosbolivar.com" || 
             getEmail() == "helen.pantoja@segurosbolivar.com";
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'asesor') == "admin")
      );
    }

    function isSupervisor() {
      return isSignedIn() && (
        getEmail() == "sergio.llanos@segurosbolivar.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'asesor') == "supervisor")
      );
    }

    // Lógica de propiedad para gestiones
    function isOwner(data) {
      return isSignedIn() && getEmail() != "" && (
        (data.get('fromAdvisorEmail', '') is string && data.get('fromAdvisorEmail', '').lower() == getEmail()) || 
        (data.get('toAdvisorEmail', '') is string && data.get('toAdvisorEmail', '').lower() == getEmail())
      );
    }

    // --- REGLAS POR COLECCIÓN ---

    match /users/{userId} {
      // Un usuario siempre puede leer su propio perfil. Los admins pueden ver todos.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      // Un usuario solo puede actualizar campos no críticos. Solo el sistema o un admin cambia roles.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email'])) ||
        isAdmin()
      );
    }

    match /login_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /registros/{registroId} {
      // Validación de ID
      allow get: if isSignedIn() && isValidId(registroId) && (isAdmin() || isSupervisor() || isOwner(resource.data));
      allow list: if isSignedIn() && (isAdmin() || isSupervisor() || isOwner(resource.data));
      
      allow create: if isSignedIn() && (
        request.resource.data.fromAdvisorEmail.lower() == getEmail() || 
        isAdmin() || 
        isSupervisor()
      );
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        isSupervisor() ||
        (isOwner(resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fromAdvisorEmail', 'createdAt']))
      );
      
      allow delete: if isAdmin();
    }

    match /advisors/{advisorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
