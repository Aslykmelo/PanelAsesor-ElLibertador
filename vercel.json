{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite"
}
